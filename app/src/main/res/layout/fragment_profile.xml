<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/TXV_FRGProfile_Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Perfil"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/IV_FRGProfile_ProfileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:contentDescription="Imagen del usuario"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_surmarket" />

        <TextView
            android:id="@+id/TXV_FRGProfile_UserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Usuario123"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TXV_FRGProfile_UserCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ID: 456789"
            android:textColor="@color/inputLetraGris"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_Email"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Correo electrónico"
                android:padding="4dp"
                android:src="@android:drawable/ic_dialog_email" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_EmailLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_Email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="usuario123@email.com"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_FullName"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Nombre completo"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_myplaces" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_FullNameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_FullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_Phone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Teléfono"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_call" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_PhoneLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_Phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+591 12345678"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_Address"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Dirección"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_mylocation" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_AddressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dirección"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_Address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calle Principal 123, Bermejo"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_RegistrationDate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Fecha de registro"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_today" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_RegistrationDateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha de registro"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_RegistrationDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="15 de marzo de 2023"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_LastAccess"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Último acceso"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_recent_history" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_LastAccessLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Último acceso"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_LastAccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="20 de mayo de 2024, 10:30 AM"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_Groups"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Grupos"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_myplaces" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_GroupsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Grupos"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_Groups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Administradores, Usuarios"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inputFondoGris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/IV_FRGProfile_Permissions"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Permisos"
                android:padding="4dp"
                android:src="@android:drawable/ic_lock_lock" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TXV_FRGProfile_PermissionsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Permisos"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TXV_FRGProfile_Permissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leer, Escribir, Eliminar"
                    android:textColor="@color/inputLetraGris"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/BTN_FRGProfile_ChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_button_rounded"
            android:paddingHorizontal="20dp"
            android:text="Cambiar contraseña"
            android:textColor="@color/black"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>